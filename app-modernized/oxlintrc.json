{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "plugins": ["typescript", "react", "react-hooks", "jsx-a11y"],
  "ignorePatterns": ["node_modules", ".next", "out", "dist"]
}
